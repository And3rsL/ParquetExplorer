{
  "name": "parquet-explorer-client",
  "private": true,
  "version": "1.0.0",
  "description": "Front-end assets (Tailwind CSS + CodeMirror SQL editor) for ParquetExplorer",
  "scripts": {
    "build:css": "tailwindcss -i ./src/app.css -o ../wwwroot/css/app.css --minify",
    "build:js": "esbuild ./src/editor.js --bundle --minify --format=iife --target=es2020 --outfile=../wwwroot/js/editor.js",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss -i ./src/app.css -o ../wwwroot/css/app.css --watch"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@tailwindcss/cli": "^4.3.3",
    "codemirror": "^6.0.2",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.3.3"
  }
}
