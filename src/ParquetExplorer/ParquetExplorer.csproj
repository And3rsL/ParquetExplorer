<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6" />
  </ItemGroup>

  <!-- Front-end sources (Tailwind + CodeMirror) are compiled into wwwroot by npm, never shipped as-is. -->
  <ItemGroup>
    <Content Remove="ClientApp\**" />
    <None Remove="ClientApp\**" />
    <Compile Remove="ClientApp\**" />
  </ItemGroup>

  <!-- dotnet build -p:BuildClientAssets=true rebuilds wwwroot/css/app.css and wwwroot/js/editor.js. -->
  <Target Name="BuildClientAssets" BeforeTargets="BeforeBuild" Condition="'$(BuildClientAssets)' == 'true'">
    <Exec Command="npm ci" WorkingDirectory="ClientApp" Condition="!Exists('ClientApp/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="ClientApp" />
  </Target>

</Project>
