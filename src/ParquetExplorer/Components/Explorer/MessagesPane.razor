<div class="h-full overflow-auto p-4 font-mono text-[12.5px] leading-relaxed">
    <div class="text-slate-400">[@Execution.StartedAt.ToString("HH:mm:ss")] Started executing query</div>
    @foreach (var note in Execution.Notes)
    {
        <div class="text-indigo-600 dark:text-indigo-300">@note</div>
    }
    @foreach (var (rs, i) in Execution.ResultSets.Select((r, i) => (r, i)))
    {
        <div class="text-slate-600 dark:text-slate-300">
            @if (rs.Columns.Count > 0)
            {
                <text>Result @(i + 1): @rs.Rows.Count.ToString("N0") row(s) loaded@(rs.Truncated ? " — more rows available, increase the row limit or export" : "").</text>
            }
            else
            {
                <text>Statement @(i + 1) executed@(rs.RecordsAffected is > 0 ? $", {rs.RecordsAffected:N0} row(s) affected" : "").</text>
            }
        </div>
    }
    @if (Execution.Error is not null)
    {
        <div class="mt-2 whitespace-pre-wrap rounded-lg border border-rose-500/30 bg-rose-500/10 p-3 text-rose-600 dark:text-rose-300">@Execution.Error</div>
    }
    <div class="mt-2 text-slate-400">Completion time: @Execution.StartedAt.Add(Execution.Elapsed).ToString("yyyy-MM-dd HH:mm:ss.fff") · elapsed @Format.Duration(Execution.Elapsed)</div>
</div>

@code {
    [Parameter, EditorRequired] public QueryExecution Execution { get; set; } = default!;
}
