@if (IsAdmin)
{
    <span class="inline-flex items-center gap-1 rounded-full bg-amber-500/15 px-2 py-0.5 text-xs font-medium text-amber-700 dark:text-amber-300"><Icon Name="shield" Class="size-3" /> Admin</span>
}
else
{
    <span class="inline-flex items-center gap-1 rounded-full bg-sky-500/15 px-2 py-0.5 text-xs font-medium text-sky-700 dark:text-sky-300"><Icon Name="user" Class="size-3" /> Viewer</span>
}

@code {
    [Parameter] public bool IsAdmin { get; set; }
}
