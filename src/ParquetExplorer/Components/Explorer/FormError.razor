@if (Message is not null)
{
    <div class="flex items-start gap-2 rounded-lg border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-sm text-rose-600 dark:text-rose-300">
        <Icon Name="alert" Class="mt-0.5 size-4 shrink-0" /> <span class="break-words">@Message</span>
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
}
