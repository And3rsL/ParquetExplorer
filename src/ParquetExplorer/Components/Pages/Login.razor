@page "/login"
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using System.ComponentModel.DataAnnotations
@inject UserStore Users
@inject NavigationManager Navigation

<PageTitle>Sign in · Parquet Explorer</PageTitle>

<div class="relative flex min-h-full items-center justify-center overflow-hidden px-4 py-12">
    <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute -top-40 left-1/2 h-[36rem] w-[36rem] -translate-x-1/2 rounded-full bg-indigo-500/20 blur-3xl"></div>
        <div class="absolute -bottom-40 right-0 h-[28rem] w-[28rem] rounded-full bg-fuchsia-500/10 blur-3xl"></div>
        <div class="absolute inset-0 bg-[linear-gradient(to_right,rgb(148_163_184/0.07)_1px,transparent_1px),linear-gradient(to_bottom,rgb(148_163_184/0.07)_1px,transparent_1px)] bg-[size:32px_32px]"></div>
    </div>

    <div class="w-full max-w-sm">
        <div class="mb-8 flex flex-col items-center text-center">
            <img src="favicon.svg" alt="" class="size-12 drop-shadow-lg" />
            <h1 class="mt-4 text-2xl font-semibold tracking-tight text-slate-900 dark:text-white">Parquet Explorer</h1>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">SQL workbench for your data lake</p>
        </div>

        <div class="panel rounded-2xl border p-6 shadow-xl shadow-slate-900/5 backdrop-blur dark:bg-slate-900/80 dark:shadow-black/30">
            <EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login" class="space-y-4">
                <DataAnnotationsValidator />

                @if (_error is not null)
                {
                    <div class="flex items-start gap-2 rounded-lg border border-rose-500/30 bg-rose-500/10 px-3 py-2 text-sm text-rose-600 dark:text-rose-300">
                        <Icon Name="alert" Class="mt-0.5 size-4 shrink-0" />
                        <span>@_error</span>
                    </div>
                }

                <div>
                    <label for="username" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Username</label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><Icon Name="user" /></span>
                        <InputText id="username" @bind-Value="Input.Username" class="input pl-9" autocomplete="username" autofocus />
                    </div>
                    <ValidationMessage For="() => Input.Username" class="mt-1 text-xs text-rose-500" />
                </div>

                <div>
                    <label for="password" class="mb-1.5 block text-sm font-medium text-slate-700 dark:text-slate-300">Password</label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-slate-400"><Icon Name="lock" /></span>
                        <InputText id="password" type="password" @bind-Value="Input.Password" class="input pl-9" autocomplete="current-password" />
                    </div>
                    <ValidationMessage For="() => Input.Password" class="mt-1 text-xs text-rose-500" />
                </div>

                <button type="submit" class="btn-primary w-full justify-center py-2.5">Sign in</button>
            </EditForm>
        </div>

        <p class="mt-6 text-center text-xs text-slate-400 dark:text-slate-500">Powered by DuckDB · Blazor</p>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(Name = "Input")] private LoginModel? FormInput { get; set; }

    private LoginModel Input => FormInput ??= new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _error;

    private async Task SignInAsync()
    {
        var (result, principal) = Users.ValidateCredentials(Input.Username, Input.Password);
        switch (result)
        {
            case LoginResult.Success:
                await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal!,
                    new AuthenticationProperties { IsPersistent = true });
                var target = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
                    ? ReturnUrl : "/";
                Navigation.NavigateTo(target, forceLoad: true);
                break;
            case LoginResult.LockedOut:
                _error = "Too many failed attempts. Try again in a few minutes.";
                break;
            default:
                _error = "Invalid username or password.";
                break;
        }
    }

    private sealed class LoginModel
    {
        [Required] public string Username { get; set; } = "";
        [Required] public string Password { get; set; } = "";
    }
}
