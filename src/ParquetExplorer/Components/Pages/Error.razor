@page "/Error"
@using System.Diagnostics

<PageTitle>Error · Parquet Explorer</PageTitle>

<div class="grid h-full place-items-center p-8">
    <div class="max-w-md text-center">
        <p class="text-2xl font-semibold text-rose-500">Something went wrong</p>
        <p class="mt-3 text-sm text-slate-500">An error occurred while processing your request.</p>
        @if (RequestId is not null)
        {
            <p class="mt-2 font-mono text-xs text-slate-400">Request ID: @RequestId</p>
        }
        <a href="" class="btn-primary mt-6">Back to explorer</a>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
