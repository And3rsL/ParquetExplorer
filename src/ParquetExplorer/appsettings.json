{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ParquetExplorer": {
    "StateDirectory": "App_Data",
    "CatalogRefreshMinutes": 10,
    "SourceManagement": {
      "AllowedLocalRoots": []
    },
    "DataSources": [
      {
        "Name": "samples",
        "Type": "Local",
        "Path": "../../samples"
      }
    ],
    "Query": {
      "DefaultRowLimit": 1000,
      "MaxRowLimit": 100000,
      "Threads": 0,
      "MemoryLimit": "",
      "TimeoutSeconds": 300,
      "EnableObjectCache": true
    },
    "Auth": {
      "SessionHours": 12,
      "MaxFailedAttempts": 5,
      "LockoutMinutes": 5,
      "Users": []
    }
  }
}
